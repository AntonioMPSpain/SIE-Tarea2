    {
      "parameters": {
        "jsCode": "// Aviso order.status_changed del back-office → POST /api/integration/sync de la tienda\n// (contrato tienda ↔ n8n, apartados 8 y 9). Se pasa el event_id del aviso (evt_bo_…):\n// la tienda lo usa para no aplicar dos veces el mismo cambio cuando el back-office reintenta.\nconst ev = $input.first().json.event;\n\nreturn [{ json: { sync: {\n  event_id: ev.event_id,\n  change_type: 'ORDER_STATUS',\n  order_ref: ev.data.order_ref,\n  new_status: ev.data.new_status,\n} } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        0
      ],
      "id": "e3f14d10-0179-4c55-a61d-80929abfc26b",
      "name": "A sync de estado"
    },
    {
      "parameters": {
        "jsCode": "// Aviso inventory.stock_updated del back-office → POST /api/integration/sync de la tienda\n// (contrato tienda ↔ n8n, apartados 8 y 9). El sku del almacén ES el product_code de la tienda.\n// new_stock es un valor absoluto: repetir la llamada no cambia nada.\nconst ev = $input.first().json.event;\n\nreturn [{ json: { sync: {\n  event_id: ev.event_id,\n  change_type: 'STOCK',\n  product_code: ev.data.sku,\n  new_stock: ev.data.new_stock,\n} } }];\n"
      },
