    },
    {
      "parameters": {
        "jsCode": "// Escenario 2 · Verifica la firma HMAC del aviso del back-office (su contrato, apartado 3.6):\n// X-Piquantum-Signature = sha256=HMAC(ERP_WEBHOOK_SECRET, cuerpo_exacto).\n// A diferencia de la tienda, NO lleva timestamp: en cada reintento el back-office envía el mismo cuerpo\n// byte a byte. Contra la repetición protege el event_id, que la tienda guarda en integration_inbox.\nconst crypto = require('crypto');\n\nconst item = $input.first();\nconst headers = item.json.headers;\nconst secret = $env.ERP_WEBHOOK_SECRET || '';\n// Cuerpo EXACTO recibido (Raw Body): si se usara item.json.body, n8n lo habría vuelto a serializar\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n\nconst received = headers['x-piquantum-signature'] || '';\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\n// Comparación en tiempo constante (como hash_equals en PHP)\nconst signatureOk = received.length === expected.length\n  && crypto.timingSafeEqual(Buffer.from(received), Buffer.from(expected));\n\nlet reason = null;\nif (!secret) reason = 'n8n sin ERP_WEBHOOK_SECRET';\nelse if (!signatureOk) reason = 'firma incorrecta';\n\nlet event = null;\ntry { event = JSON.parse(raw); } catch (e) { reason = reason || 'cuerpo que no es JSON'; }\nif (!reason && event.source !== 'piquantum.backoffice.erp') reason = 'source desconocido';\n\nreturn [{ json: { valid: reason === null, reason, event } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        240
      ],
      "id": "5caa4005-3fd7-44fd-a6c1-bc08a0dd36eb",
      "name": "Verificar firma"
    },
