# Variables del despliegue (deploy/docker-compose.yml).
# En el servidor: cp .env.example .env y sustituye cada "cambia-esto" por un valor propio.
# deploy/.env NUNCA se sube a Git.
#
# Para generar claves aleatorias:   openssl rand -hex 32

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------
# Cifra las credenciales guardadas en n8n. Guarda una copia fuera del servidor:
# si se pierde, las credenciales de n8n ya no se pueden leer.
N8N_ENCRYPTION_KEY=cambia-esto

# ---------------------------------------------------------------------------
# Back-office (también se pasan a n8n como ERP_API_KEY y ERP_WEBHOOK_SECRET)
# ---------------------------------------------------------------------------
# Cabecera X-Integration-Token con la que n8n llama a la API del back-office
INTEGRATION_API_KEY=cambia-esto
# Firma HMAC de los avisos del back-office a n8n
WEBHOOK_HMAC_SECRET=cambia-esto

# Acceso del operador a https://erp.piquantum.onl
ERP_ADMIN_EMAIL=operador@erp.piquantum.test
# Hash bcrypt de la contraseña, ENTRE COMILLAS SIMPLES (si no, Docker Compose
# interpreta los "$" del hash). Para generarlo en el servidor:
#   docker run --rm -it php:8.3-cli-alpine php -r 'echo password_hash(trim(fgets(STDIN)), PASSWORD_DEFAULT), PHP_EOL;'
# (escribe la contraseña y pulsa Enter)
ERP_ADMIN_PASSWORD_HASH='cambia-esto'

# ---------------------------------------------------------------------------
# Tienda (Fase 1). Pueden quedar vacías hasta que la tienda esté adaptada.
# Deben coincidir con N8N_WEBHOOK_SECRET e INTEGRATION_API_TOKEN del .env de la tienda.
# ---------------------------------------------------------------------------
# Firma HMAC de los webhooks tienda -> n8n
PIQUANTUM_WEBHOOK_SECRET=
# Token Bearer de n8n -> POST /api/integration/sync de la tienda
PIQUANTUM_SYNC_TOKEN=
# PIQUANTUM_SYNC_URL=https://www.piquantum.onl/api/integration/sync
