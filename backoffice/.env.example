# =========================================================================
# PIQUANTUM BACK-OFFICE ERP & CUADRO DE MANDO OPERATIVO (TAREA 2 - SIE)
# Archivo de ejemplo de variables de entorno (SIN SECRETOS REALES)
# =========================================================================

APP_NAME="Piquantum Back-Office ERP"
APP_ENV=local
APP_URL=http://127.0.0.1:8080

# Base de datos independiente del Back-Office (sqlite o mysql)
DB_CONNECTION=sqlite
DB_SQLITE_PATH=storage/database/piquantum_erp.sqlite

# Configuración opcional si se despliega con MySQL / MariaDB en Google Cloud VM
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=piquantum_erp_db
DB_USERNAME=erp_user
DB_PASSWORD=cambia-esto

# Acceso del operador a la web del Back-Office (Prototipo Académico)
# La contraseña NO se guarda en claro: solo su hash bcrypt. Para generarlo (escribe la contraseña y pulsa Enter):
#   php -r 'echo password_hash(trim(fgets(STDIN)), PASSWORD_DEFAULT), PHP_EOL;'
# y pega el resultado entre comillas simples. Si se deja vacío, no se puede iniciar sesión.
ERP_ADMIN_EMAIL=operador@erp.piquantum.test
ERP_ADMIN_PASSWORD_HASH=

# Seguridad del contrato de integración con n8n / Canal Digital (OBLIGATORIAS)
# Copia este archivo a .env y pon valores propios; .env.example nunca se usa como configuración.
# Con "cambia-esto" o vacías, el Back-Office no arranca. Para generar un valor: openssl rand -hex 32
INTEGRATION_API_KEY=cambia-esto
WEBHOOK_HMAC_SECRET=cambia-esto

# URLs de Webhooks de salida hacia n8n (para Escenario 2 y Aprobación Humana Escenario 3)
N8N_WEBHOOK_OPERATIONAL_CHANGE_URL=http://localhost:5678/webhook/piquantum-operational-change
N8N_WEBHOOK_HUMAN_REVIEW_URL=http://localhost:5678/webhook/piquantum-human-review
